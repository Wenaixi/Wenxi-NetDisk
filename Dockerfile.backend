# Wenxi网盘 - 后端 Dockerfile
# 作者：Wenxi
# 功能：运行FastAPI后端服务，端口8088

FROM python:3.11-slim

WORKDIR /app

# 安装系统依赖
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    libpq-dev \
    && rm -rf /var/lib/apt/lists/*

# 复制依赖文件
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# 复制后端代码
COPY backend/ ./backend/
COPY logger.py .
COPY cli.py .

# 创建上传目录
RUN mkdir -p /app/backend/uploads

# 环境变量
ENV PYTHONPATH=/app
ENV PORT=8088

# 暴露8088端口
EXPOSE 8088

# 启动命令
CMD ["python", "-m", "uvicorn", "backend.main:app", "--host", "0.0.0.0", "--port", "8088", "--log-level", "info"]
