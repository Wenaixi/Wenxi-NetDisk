# ===========================================
# Wenxi Cloud Disk - .gitignore
# ===========================================

# Go
# ----
# Build outputs
*.exe
*.exe~
*.dll
*.so
*.dylib
server.exe

# Test binaries
*.test
*_test.exe

# Coverage output
*.out
coverage.out

# Go workspace (if using multi-module)
go.work
go.work.sum

# Dependencies vendor
vendor/

# Backend build directory
backend/server
backend/server.exe
backend/data/
backend/*.db

# Frontend
# --------
# Dependencies
frontend/node_modules/
frontend/.vite/
frontend/.cache/
frontend/.temp/

# Build outputs
frontend/dist/
frontend/build/

# Environment files (NEVER commit these)
.env
.env.local
.env.*.local
.env.production
.env.production.local

# Logs
*.log
logs/
frontend/*.log

# Editor & IDE
# ------------
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini
*.sublime-*
*.code-workspace

# Security sensitive (NEVER commit these)
*.pem
*.key
*.crt
*.cer
*.p12
*.pfx
*.ovpn

# Temporary files
# ---------------
*.tmp
*.temp
tmp/
temp/
.tmp/
.temp/
*.swp
*.swo

# Database files (local development)
*.db
*.sqlite
*.sqlite3
**/*.db
**/*.sqlite

# Upload directories (NEVER commit user data)
uploads/
temp_chunks/
**/uploads/
**/temp_chunks/

# Test coverage
coverage/
*.lcov
.nyc_output/

# Rust (if any)
target/
.cargo/

# Claude Code (local development tool state)
.claude/
.claude/settings.json

# OS files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db

# npm/yarn/pnpm
.npm
.yarn
.pnpm
package-lock.json
yarn.lock
pnpm-lock.yaml

# TypeScript
*.tsbuildinfo
*.tsbuildinfo.*

# ESLint
.eslintcache
.eslintrc.cache

# Prettier
.prettiercache
.prettierrc.cache

# Vite
vite.config.*.ts
vite.config.*.js
