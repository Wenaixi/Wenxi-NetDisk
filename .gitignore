# ===========================================
# Wenxi Cloud Disk - .gitignore
# ===========================================

# Go
# Build output
*.exe
*.exe~
*.dll
*.so
*.dylib
server.exe
backend/server.exe

# Test binary
*.test

# Output of go coverage
*.out

# Go workspace file
go.work

# Dependencies
vendor/

# Database files (local development)
*.db
*.sqlite
*.sqlite3
data/*.db
data/*.sqlite

# Environment files
.env
.env.local
.env.*.local

# Logs
*.log
logs/

# Node.js (frontend)
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Frontend build outputs
frontend/dist/
frontend/build/
frontend/.vite/
frontend/.cache/
frontend/.temp/
frontend/node_modules/

# Build artifacts
dist/
build/
*.tgz

# Editor directories and files
.vscode/
.idea/
*.swp
*.swo
*~
*.bak
*.backup
*.orig
*.rej
*.sublime-*
*.code-workspace

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# Security sensitive files
*.pem
*.key
*.crt
*.cer
*.p12
*.pfx

# Temporary files
*.tmp
*.temp
tmp/
temp/
.tmp/
.temp/

# TypeScript
*.tsbuildinfo

# Optional npm cache
.npm
.yarn-integrity

# Optional eslint cache
.eslintcache

# Test coverage
coverage/
*.lcov
.nyc_output/

# Cargo (Rust)
target/
.cargo/config.toml

# Temporary test databases
test.db
test_*.db

# Backend data directory
backend/data/

# Upload directories
uploads/
temp_chunks/
**/uploads/
**/temp_chunks/
