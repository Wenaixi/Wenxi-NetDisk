# Wenxi Cloud Disk - Environment Configuration
# Copy this file to .env and configure

# Server Configuration
SERVER_PORT=8080

# Database Configuration
DB_PATH=./data/wenxi.db

# JWT Configuration
JWT_SECRET=your-secret-key-change-in-production
JWT_EXPIRE_MINUTES=30

# LanZouCloud (Optional - for direct upload)
# LANZOU_COOKIE=your-lanzou-cloud-cookie
# LANZOU_TOKEN=your-lanzou-cloud-token
